# FINVOSMART Frontend Environment
# Copy to .env.local for local development

# API URL — baked in at build time. Behind nginx it is /api/v1, which is also what a production
# build uses when this is unset. For `npm run dev` against a local backend: the full URL below.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# App metadata
NEXT_PUBLIC_APP_NAME=FINVOSMART
NEXT_PUBLIC_VERSION=1.1.0

# Features still on demo data (AI pages, expense claims, client portal, recurring billing,
# demand forecast, e-signing, automations, timesheets, marketplace). Leave false in production;
# true only for a sales demo, together with PREVIEW_FEATURES=true on the backend.
NEXT_PUBLIC_PREVIEW_FEATURES=false
