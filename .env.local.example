# FINVOSMART Frontend — Environment Configuration
# Copy this file to .env.local and fill in your values

# Backend API URL, baked in when the web app is built. For `npm run dev` against a local backend:
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# In production the web app and the API are one site behind nginx: leave it unset (or /api/v1) when building —
# an address on another site would need CORS_ORIGINS on the backend and is not needed.
